{
  "info": {
    "name": "Poll App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" },
    { "key": "itemId", "value": "", "type": "string" },
    { "key": "optionId", "value": "", "type": "string" },
    { "key": "optionId2", "value": "", "type": "string" },
    { "key": "anonUserId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Flow 1 — Anonymous User",
      "description": "Sign in anonymously, create and manage events.",
      "item": [
        {
          "name": "1. Sign In Anonymously",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Anonymous sign-in succeeds', () => {",
            "  pm.response.to.have.status(200);",
            "  const json = pm.response.json();",
            "  pm.expect(json.user.isAnonymous).to.be.true;",
            "  pm.collectionVariables.set('anonUserId', json.user.id);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/sign-in/anonymous", "host": ["{{baseUrl}}"], "path": ["api","auth","sign-in","anonymous"] }
          }
        },
        {
          "name": "2. Get Session (verify anon)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Session is anonymous', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().user.isAnonymous).to.be.true;",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/get-session", "host": ["{{baseUrl}}"], "path": ["api","auth","get-session"] }
          }
        },
        {
          "name": "3. Create Event (as anon)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Event created with anon creatorId', () => {",
            "  pm.response.to.have.status(201);",
            "  const json = pm.response.json();",
            "  pm.expect(json.data.creatorId).to.eql(pm.collectionVariables.get('anonUserId'));",
            "  pm.collectionVariables.set('eventId', json.data.id);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Anon User Poll\",\n  \"type\": \"poll\",\n  \"description\": \"Created by anonymous user\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Flow 2 — Account Linking (Anon → Real User)",
      "description": "Sign up while having an active anon session. Events should migrate.",
      "item": [
        {
          "name": "1. Sign Up (links anon account)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Sign up returns real user', () => {",
            "  pm.response.to.have.status(200);",
            "  const json = pm.response.json();",
            "  pm.expect(json.user.isAnonymous).to.not.be.true;",
            "  pm.collectionVariables.set('userId', json.user.id);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/sign-up/email", "host": ["{{baseUrl}}"], "path": ["api","auth","sign-up","email"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\"\n}" }
          }
        },
        {
          "name": "2. Verify Events Migrated to Real User",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Events migrated to real user', () => {",
            "  const json = pm.response.json();",
            "  json.data.forEach(e => pm.expect(e.creatorId).to.eql(pm.collectionVariables.get('userId')));",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events?creatorId={{userId}}", "host": ["{{baseUrl}}"], "path": ["events"], "query": [{ "key": "creatorId", "value": "{{userId}}" }] }
          }
        }
      ]
    },
    {
      "name": "Flow 3 — Full Poll Lifecycle",
      "description": "Auth → create event → add items/options → start → respond → analytics → publish",
      "item": [
        {
          "name": "1. Sign In",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Sign in succeeds', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.collectionVariables.set('userId', pm.response.json().user.id);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/sign-in/email", "host": ["{{baseUrl}}"], "path": ["api","auth","sign-in","email"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "2. Create Poll Event",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Poll created', () => {",
            "  pm.response.to.have.status(201);",
            "  const d = pm.response.json().data;",
            "  pm.expect(d.status).to.eql('pending');",
            "  pm.expect(d.resultsVisibility).to.eql('public');",
            "  pm.collectionVariables.set('eventId', d.id);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Favourite Framework?\",\n  \"type\": \"poll\",\n  \"description\": \"Vote for your favourite JS framework\",\n  \"resultsVisibility\": \"public\"\n}" }
          }
        },
        {
          "name": "3. Add Item (question)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Item created', () => {",
            "  pm.response.to.have.status(201);",
            "  pm.collectionVariables.set('itemId', pm.response.json().data.id);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/items", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","items"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Which framework do you prefer?\",\n  \"order\": 1,\n  \"isMandatory\": true\n}" }
          }
        },
        {
          "name": "4. Set Options (batch — React & Vue)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Both options created', () => {",
            "  pm.response.to.have.status(200);",
            "  const opts = pm.response.json().data;",
            "  pm.expect(opts.length).to.eql(2);",
            "  pm.collectionVariables.set('optionId', opts[0].id);",
            "  pm.collectionVariables.set('optionId2', opts[1].id);",
            "});"
          ]}}],
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/items/{{itemId}}/options", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","items","{{itemId}}","options"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"options\": [\n    { \"text\": \"React\", \"order\": 1 },\n    { \"text\": \"Vue\", \"order\": 2 }\n  ]\n}" }
          }
        },
        {
          "name": "4a. Update Options (batch — rename + add Svelte)",
          "description": "Re-send all options to update. Include existing IDs to keep them stable.",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Options replaced', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().data.length).to.eql(3);",
            "});"
          ]}}],
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/items/{{itemId}}/options", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","items","{{itemId}}","options"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"options\": [\n    { \"id\": \"{{optionId}}\", \"text\": \"React (Meta)\", \"order\": 1 },\n    { \"id\": \"{{optionId2}}\", \"text\": \"Vue\", \"order\": 2 },\n    { \"text\": \"Svelte\", \"order\": 3 }\n  ]\n}" }
          }
        },
        {
          "name": "6. List Items (with options)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Items list contains options', () => {",
            "  pm.response.to.have.status(200);",
            "  const items = pm.response.json().data;",
            "  pm.expect(items[0].options.length).to.be.greaterThan(0);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/items", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","items"] }
          }
        },
        {
          "name": "7. Get Single Item (with options)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Single item has options', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().data.options).to.exist;",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/items/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","items","{{itemId}}"] }
          }
        },
        {
          "name": "8. Update Item",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Item updated', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().data.text).to.eql('Which JS framework is your favourite?');",
            "});"
          ]}}],
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/items/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","items","{{itemId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Which JS framework is your favourite?\"\n}" }
          }
        },
        {
          "name": "9. Update Option",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Option updated', () => {",
            "  pm.response.to.have.status(200);",
            "});"
          ]}}],
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/items/{{itemId}}/options/{{optionId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","items","{{itemId}}","options","{{optionId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"React (Meta)\"\n}" }
          }
        },
        {
          "name": "10. Start Event (pending → running)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Event is running', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().data.status).to.eql('running');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/start", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","start"] }
          }
        },
        {
          "name": "11. Update Item While Running (should fail 400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Blocked when not pending', () => {",
            "  pm.response.to.have.status(400);",
            "});"
          ]}}],
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/items/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","items","{{itemId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"text\": \"Should not work\" }" }
          }
        },
        {
          "name": "12. Submit Poll Response",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Response accepted', () => {",
            "  pm.response.to.have.status(201);",
            "  const d = pm.response.json().data;",
            "  pm.expect(d.participantId).to.exist;",
            "  pm.expect(d.submittedAt).to.exist;",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/respond", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","respond"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"answers\": [\n    { \"itemId\": \"{{itemId}}\", \"optionId\": \"{{optionId}}\" }\n  ]\n}" }
          }
        },
        {
          "name": "13. Submit Again (should fail 409)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Duplicate response rejected', () => {",
            "  pm.response.to.have.status(409);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/respond", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","respond"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"answers\": [\n    { \"itemId\": \"{{itemId}}\", \"optionId\": \"{{optionId}}\" }\n  ]\n}" }
          }
        },
        {
          "name": "14. Get Analytics (public)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Analytics returned', () => {",
            "  pm.response.to.have.status(200);",
            "  const d = pm.response.json().data;",
            "  pm.expect(d.totalResponses).to.eql(1);",
            "  pm.expect(d.items[0].options[0].voteCount).to.eql(1);",
            "  pm.expect(d.items[0].options[0].percentage).to.eql(100);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/analytics", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","analytics"] }
          }
        },
        {
          "name": "15. Complete Event (running → completed)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Event completed', () => {",
            "  pm.expect(pm.response.json().data.status).to.eql('completed');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/complete", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","complete"] }
          }
        },
        {
          "name": "16. Publish Event",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Event published', () => {",
            "  const d = pm.response.json().data;",
            "  pm.expect(d.isPublished).to.be.true;",
            "  pm.expect(d.status).to.eql('completed');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/publish", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","publish"] }
          }
        },
        {
          "name": "17. Sign Out",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/sign-out", "host": ["{{baseUrl}}"], "path": ["api","auth","sign-out"] }
          }
        }
      ]
    },
    {
      "name": "Flow 4 — Private Results",
      "description": "Verify private resultsVisibility blocks analytics for non-creators.",
      "item": [
        {
          "name": "1. Create Private Poll",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Private poll created', () => {",
            "  pm.response.to.have.status(201);",
            "  pm.collectionVariables.set('eventId', pm.response.json().data.id);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Secret Poll\",\n  \"type\": \"poll\",\n  \"resultsVisibility\": \"private\"\n}" }
          }
        },
        {
          "name": "2. Get Analytics as Creator (200)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Creator can see analytics', () => {",
            "  pm.response.to.have.status(200);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/analytics", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","analytics"] }
          }
        },
        {
          "name": "3. Get Analytics as Non-Creator (403)",
          "description": "Sign in as a different user first, then hit this endpoint.",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Non-creator blocked from private analytics', () => {",
            "  pm.response.to.have.status(403);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/analytics", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","analytics"] }
          }
        }
      ]
    },
    {
      "name": "Validation & Error Cases",
      "item": [
        {
          "name": "Create Event — Missing required fields (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 for missing fields', () => pm.response.to.have.status(400));"] }}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"description\": \"missing title and type\" }" }
          }
        },
        {
          "name": "Respond — Missing mandatory item (400)",
          "description": "Event must be running and have a mandatory item. Submit with empty answers array.",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 for missing mandatory answer', () => pm.response.to.have.status(400));"] }}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/respond", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","respond"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"answers\": [] }" }
          }
        },
        {
          "name": "Respond — Event not running (400)",
          "description": "Use an eventId for a pending event.",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 for non-running event', () => pm.response.to.have.status(400));"] }}],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/respond", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","respond"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"answers\": [{ \"itemId\": \"{{itemId}}\", \"optionId\": \"{{optionId}}\" }] }" }
          }
        },
        {
          "name": "Get Event — Not found (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 for unknown event', () => pm.response.to.have.status(404));"] }}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events/nonexistent-id", "host": ["{{baseUrl}}"], "path": ["events","nonexistent-id"] }
          }
        }
      ]
    }
  ]
}
