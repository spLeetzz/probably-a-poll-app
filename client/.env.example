# Target for /api/auth in dev (Vite proxy). Default: http://localhost:4000 (backend on 4000).
VITE_POLL_API_TARGET=http://localhost:4000

# If the SPA is served from a different origin than the API (production), set the API origin.
# Leave unset in dev when using the proxy (same origin as the Vite app).
# VITE_AUTH_BASE_URL=http://localhost:4000

# Google OAuth + password reset redirect URLs must be trusted by Better Auth. With Vite on
# port 3000, set e.g. BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000 (comma-separated list).
#
# Password reset email delivery requires emailAndPassword.sendResetPassword in server auth config.
